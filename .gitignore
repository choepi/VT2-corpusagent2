# Python-generated files
__pycache__/
*.py[oc]
*.pyo
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Local uv cache
.uv-cache/

# Local environment
.env
.env.local
.env.*.local

# Generated corpus data / indexes / archives
/data/archive/
/data/raw/
/data/staged/
/data/processed/
/data/indices/

# Runtime outputs
/outputs/**
!/outputs/.gitkeep

# Throwaway HTML/markdown-preview exports and repo-state dumps
/out/

# Logs
/log/
/logs/
*.log

# Slurm runtime logs
/slurm/*.out
/slurm/*.err
/slurm/**/*.out
/slurm/**/*.err

# VM / Docker state
/deploy/data/

# Large/generated artifacts anywhere
*.parquet
*.npy
*.npz
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.sqlite
*.duckdb
*.tar
*.tar.gz
*.zip

# Raw/generated JSONL only in generated dirs
/data/**/*.jsonl
/data/**/*.jsonl.gz
/outputs/**/*.jsonl
/outputs/**/*.jsonl.gz

# Local DB dumps / backups (too large for GitHub; keep on disk only)
/backups/

# Scratch run-id files written by ad-hoc query submissions
/.fbrid
/.oilrid
/.climate_rid
/*.rid

# IDE / OS
.DS_Store
Thumbs.db
.claude/settings.local.json

# Large run-provenance archives (reproducible from outputs/; keep out of git)
project_paper/results_exports/*.zip
